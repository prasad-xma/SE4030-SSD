NODE_ENV=development
PORT=3000

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection string
mongoURL=

# Stripe secret keys (test mode)
STRIPE_SECRET=
CUS_STRIPE=

# Gmail account used to send transactional emails (use an App Password, not your real password)
EMAIL_USER=
EMAIL_PASS=
